{
  "name": "SugarCubes",
  "version": "0.14.5",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsx scripts/build-web.ts",
    "build:check": "tsx scripts/build-web.ts --check",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:list": "python -m tools.test list",
    "test:validate": "python -m tools.test validate",
    "test:all": "python -m tools.test all",
    "test:explain": "python -m tools.test explain",
    "test:run": "python -m tools.test run",
    "test:isolated": "python -m tools.test isolated",
    "test:changed": "python -m tools.test changed",
    "test:staged": "python -m tools.test staged",
    "test:commit": "python -m tools.test staged --commit",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.tests.json --noEmit && python scripts/run_mypy.py",
    "audit:standards": "python scripts/standards_audit.py && tsx scripts/standards-audit.ts",
    "architecture": "python -m tools.check_architecture",
    "architecture:staged": "python -m tools.check_architecture --staged",
    "lint": "eslint \"frontend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "python -m black . --exclude \"\\.venv|node_modules|cubes\" && prettier --write \"frontend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\"",
    "format:check": "python -m black --check . --exclude \"\\.venv|node_modules|cubes\" && prettier --check \"frontend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\"",
    "check": "npm run format:check && python -m ruff check . --exclude node_modules,cubes && npm run audit:standards && npm run architecture && npm run typecheck && npm run lint && npm run build:check && npm run test:all",
    "check:commit": "npm run check",
    "release": "semantic-release"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "private": true
}
